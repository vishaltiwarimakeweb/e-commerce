# MongoDB
MONGODB_URI=mongodb://localhost:27017/woozi-ecommerce

# Custom JWT auth (session cookie signing secret)
JWT_SECRET=replace-with-a-long-random-secret

# Base URL of the app, used to build OAuth redirect URIs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# GitHub OAuth (github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# Cloudinary (media uploads — review images in this phase)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
